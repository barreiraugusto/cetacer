# Copiar como .env y completar. En desarrollo el proyecto funciona sin este archivo.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cetacer.com,www.cetacer.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cetacer.com,https://www.cetacer.com
# Sólo mientras el sitio se sirva por IP, sin certificado: apaga HSTS, la
# redirección a HTTPS y las cookies seguras. Con TLS en su lugar, volvé a True.
DJANGO_HTTPS=True
# Opcional: si no se define se usa SQLite
# DATABASE_URL=postgres://usuario:clave@localhost:5432/cetacer
